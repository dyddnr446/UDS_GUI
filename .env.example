# Copy to .env and fill in. Do NOT commit .env (gitignored).
# OS environment variables always win over .env.

# OpenAI-compatible API (FR-18: never put the real key in git)
UDS_AI_API_KEY=
UDS_AI_BASE_URL=https://api.openai.com/v1
UDS_AI_MODEL=gpt-4o-mini

# Optional: folder that contains docs/, samples/, config/
# Leave empty to auto-detect from cwd / exe location
UDS_APP_HOME=
