# Project-root .env
# 원래 .env / API 키는 Git에 올리면 안 되지만, 이 파일은 과제 제출·채점용으로 포함합니다.
# OS environment variables always win over .env.

# TRUE  = offline fixture ECU + Interpreter log/JSON test
# FALSE = live CAN path (not implemented yet)
TEST=TRUE

# Leave empty — auto-detect project root (recommended)
UDS_APP_HOME=

# Catalog SSOT (DID/DTC + SID masters under catalog/)
UDS_CATALOG_DIR=catalog
UDS_FIXTURE_PATH=fixtures/uds_fixture_scenarios.xlsx

# demo_session.log directory
UDS_SAMPLES_DIR=fixtures

# Demo ECU / SecurityAccess (0x27) password
UDS_DEMO_PASSWORD=1234

# --- Gemini API (OpenAI-compatible endpoint via LangChain4j OpenAiChatModel) ---
# 과제 제출용 데모(무료) 키 — 일반적으로는 커밋하지 않음
UDS_AI_API_KEY=AIzaSyC_41fLqyC-aQv-I6g5ONxEpkeSM6Gckho
UDS_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
UDS_AI_MODEL=gemini-2.5-flash

# Editable AI prompt template (system + user). Placeholders: {{profileId}} {{symptom}} {{facts}}
UDS_AI_PROMPT_PATH=ai_advisor_prompt.txt
